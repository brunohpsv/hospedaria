rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client establishment profile and isolated subcollections
    match /clients/{clientId} {
      allow read, write: if true;

      // Multi-tenant subcollections: rooms, guests, categories, ratePlans, workplaces, employees
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // System configurations and administrative authentication
    match /system_config/{docId} {
      allow read, write: if true;
    }

    // Global fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
