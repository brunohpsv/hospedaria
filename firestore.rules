rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hotel Notepad Management Rules
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /guests/{guestId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /ratePlans/{planId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
